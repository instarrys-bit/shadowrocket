#!name=YouTube Ads Helper
#!desc=Conservative YouTube helper. Does not change DNS or proxy routing. HTTPS body modification requires HTTPS decryption to be enabled separately.

[Script]
YouTube Response = type=http-response,pattern=^https?://youtubei\.googleapis\.com/youtubei/v1/(browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/instarrys-bit/shadowrocket/main/youtube_response.js
YouTube Request Log Event = type=http-request,pattern=^https?://youtubei\.googleapis\.com/youtubei/v1/log_event(\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/instarrys-bit/shadowrocket/main/youtube_request_local.js

[MITM]
hostname = %APPEND% youtubei.googleapis.com
